        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#CD0A1B;" value="Migration Plan: Dashboard -&amp;gt; Databricks App Tab" vertex="1">

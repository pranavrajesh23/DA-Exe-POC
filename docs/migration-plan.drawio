        </mxCell>
        <mxCell id="box1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CD0A1B;strokeWidth=2;fontSize=13;fontColor=#221F1F;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="1 . AUDIT THE VISUALS&#xa;Take every chart, KPI, table and filter in the static dashboard and rebuild each one as its own reusable component." vertex="1">
          <mxGeometry height="90" width="380" x="40" y="90" as="geometry" />

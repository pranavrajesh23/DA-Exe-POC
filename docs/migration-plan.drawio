        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#575454;" value="Correct order: audit and reuse the VISUALS, audit and reuse the DESIGN, then compose a new page by importing both" vertex="1">
